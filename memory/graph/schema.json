{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex-OS Graph Memory Event",
  "type": "object",
  "required": ["id", "type", "subject", "summary", "source", "confidence", "created_at"],
  "properties": {
    "id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["preference", "principle", "project", "commitment", "decision", "skill", "relationship", "fact"]
    },
    "subject": { "type": "string" },
    "summary": { "type": "string" },
    "source": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "personal", "private", "secret"],
      "default": "personal"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "review_after": { "type": "string", "format": "date" },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}

